{
  "name": "@stencil-community/less",
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist && npm run test && npm run lint",
    "build": "tsc && npm run rollup",
    "watch": "tsc --watch",
    "rollup": "rollup -c",
    "version": "npm run build",
    "release": "np",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test.watch": "jest --watch"
  },
  "dependencies": {
    "less": "^4.9.1"
  },
  "peerDependencies": {
    "@stencil/core": "^4.0.0 || ^5.0.0-0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/less": "^3.0.8",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "np": "^12.1.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencil-community/stencil-less.git"
  },
  "author": "Ionic Team",
  "homepage": "https://stenciljs.com/",
  "description": "The Stencil Less Plugin",
  "keywords": [
    "stencil",
    "less"
  ],
  "jest": {
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "@swc/jest",
        {
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "testRegex": "(\\.(test|spec))\\.(tsx?|jsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "jsx"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost"
    }
  }
}
